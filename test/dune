(test
 (name test_cli)
 ; The cram fixture executable is a runtime dependency: the end-to-end
 ; default-path test invokes it through its _build path.
 (modules test_cli)
 (libraries thumper unix windtrap)
 (deps cram/fixture/bench_fixture.exe))

(test
 (name test_stats)
 ; The golden corpus is a runtime dependency.
 (modules test_stats)
