(test
 (name test_measure)
 ; The C fixture stops a forked worker as a traced child. Its slow tests
 ; measure on the real clock, so they take the cram sessions' lock.
 (modules test_measure)
 (locks ../cram/measurement)
 (foreign_stubs
  (language c)
  (names stop_stubs))
 (libraries thumper unix windtrap))

(test
 (name test_verdict)
 ; Its baselines: the JSON documents under json/ and the warning texts in
 ; the source.
 (modules test_verdict)
 (libraries thumper windtrap)
 (deps
  (glob_files json/*.json))
 (action
  (progn
   (run %{test} --corrected)
   (concurrent
    (diff? test_verdict.ml test_verdict.ml.corrected)
    (diff?
     json/confirmed-regression.json
     json/confirmed-regression.json.corrected)
    (diff? json/environment.json json/environment.json.corrected)
    (diff? json/exact-changes.json json/exact-changes.json.corrected)
    (diff? json/exact.json json/exact.json.corrected)
    (diff? json/no-comparison.json json/no-comparison.json.corrected)
    (diff? json/passing.json json/passing.json.corrected)
    (diff? json/unconfirmed.json json/unconfirmed.json.corrected)))))

