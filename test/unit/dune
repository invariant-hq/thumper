(test
 (name test_report)
 (modules test_report)
 (libraries thumper windtrap)
 (deps
  (glob_files report/*.txt))
 (action
  (progn
   (run %{test} --corrected)
   (concurrent
    (diff? report/bless.txt report/bless.txt.corrected)
    (diff? report/default-budget.txt report/default-budget.txt.corrected)
    (diff? report/failing-first.txt report/failing-first.txt.corrected)
    (diff? report/loaded-proposed.txt report/loaded-proposed.txt.corrected)
    (diff? report/bless-forced.txt report/bless-forced.txt.corrected)
    (diff? report/case-warning.txt report/case-warning.txt.corrected)
    (diff? report/equivalent.txt report/equivalent.txt.corrected)
    (diff? report/exact-alloc.txt report/exact-alloc.txt.corrected)
    (diff? report/exact-regressed.txt report/exact-regressed.txt.corrected)
    (diff? report/github.txt report/github.txt.corrected)
    (diff? report/growth-from-zero.txt report/growth-from-zero.txt.corrected)
    (diff? report/improved.txt report/improved.txt.corrected)
    (diff? report/inconclusive.txt report/inconclusive.txt.corrected)
    (diff? report/loaded.txt report/loaded.txt.corrected)
    (diff? report/mixed.txt report/mixed.txt.corrected)
    (diff? report/mixed-styled.txt report/mixed-styled.txt.corrected)
    (diff? report/no-baseline.txt report/no-baseline.txt.corrected)
    (diff?
     report/no-baseline-loaded.txt
     report/no-baseline-loaded.txt.corrected)
    (diff?
     report/over-cap-first-run.txt
     report/over-cap-first-run.txt.corrected)
    (diff? report/over-cap-new-row.txt report/over-cap-new-row.txt.corrected)
    (diff? report/over-cap-sampled.txt report/over-cap-sampled.txt.corrected)
    (diff? report/proposed-metric.txt report/proposed-metric.txt.corrected)
