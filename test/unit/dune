 (modules test_config)
 (libraries thumper windtrap))

(test
 (name test_bench)
 (modules test_bench)
 (libraries thumper windtrap))

(test
 (name test_env)
 (modules test_env)
 (libraries thumper thumper_clock unix windtrap))

(test
 (name test_os)
 (modules test_os)
 (libraries thumper thumper_clock unix windtrap))

(test
 (name test_baseline)
